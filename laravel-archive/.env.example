APP_NAME="SMA Ahlul Irfan Bangsalsari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Satu-satunya sumber URL kanonik. JANGAN pernah menulis keras nama domain
# di dalam kode — situs lahir di alamat sementara lalu pindah ke .sch.id.
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Dev lokal: sqlite (nol setup, satu file di database/database.sqlite).
DB_CONNECTION=sqlite

# Dev lokal alternatif memakai MySQL bawaan MAMP — pakai ini kalau ingin
# lingkungan lokal persis sama dengan produksi. Jalankan MAMP lebih dulu.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=8889
# DB_DATABASE=sma_ahlulirfan
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# Produksi (BiznetGio cPanel): mysql, kredensial dari cPanel > MySQL Databases.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Wajib `public` — media diakses lewat symlink public/storage.
FILESYSTEM_DISK=public

# Konversi gambar medialibrary dijalankan langsung dalam request.
# Shared hosting tidak punya daemon queue; cukup untuk situs sekecil ini.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# --- Email ---
# WAJIB diisi di produksi. Tanpa SMTP, reset password TIDAK BERFUNGSI.
# Pakai mailbox dari hosting itu sendiri (cPanel > Email Accounts).
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
